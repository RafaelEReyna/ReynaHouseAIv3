---
// Landing page for the free Google listing check (GBP Offer post, 2026-09-29).
// Copy is Edward's voice: states what happens, no verdicts, no price, no dashes.
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ListingCheckForm from '../components/ListingCheckForm.astro';

const checks = [
  ['Hours.', 'Regular hours, weekends, and holiday hours.'],
  ['Services and category.', 'Whether what the listing says you do matches the work you actually do.'],
  ['Phone and website.', 'Whether the number matches the one on your website, and whether the link opens.'],
  ['Address or service area.', 'Whether the map shows where you actually work.'],
  ['Reviews.', 'Any that never got a reply.'],
];
---

<Layout
  title="Free Google Listing Check"
  description="Send me your business name and town. I'll look at your Google listing the way a customer sees it and send you what looks wrong or missing."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://reynahouse.ai/" },
        { "@type": "ListItem", "position": 2, "name": "Free Google Listing Check", "item": "https://reynahouse.ai/free-listing-check/" },
      ],
    })} />
  </Fragment>

  <Header />

  <main class="page">
    <article class="intro">
      <div class="intro__container">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a> <span aria-hidden="true">/</span> Free Listing Check
        </nav>
        <span class="overline">Google Business Profile</span>
        <h1 class="h1">Free Google Listing Check</h1>
        <p class="lede">
          Google has been using a robot to call businesses and ask about their hours,
          services, and booking. Its own help page says whatever the person who picks up
          tells it gets added to the listing. So your listing can say something about your
          business that you never said yourself.
        </p>
        <p class="lede lede--gold">
          Send me your business name and town. I'll look at your listing the way a
          customer sees it and send you what looks wrong or missing.
        </p>
      </div>
    </article>

    <section class="section">
      <div class="section__container">
        <h2 class="h2">What I Look At</h2>
        <ul class="checks">
          {checks.map(([name, detail]) => <li><strong>{name}</strong> {detail}</li>)}
        </ul>
      </div>
    </section>

    <section class="section section--tint">
      <div class="section__container">
        <h2 class="h2">What I Can't See</h2>
        <p class="body">
          I see what your customers see. The Collected info tab Google started rolling out
          on September 14 shows the owner what the robot gathered, and only the owner can
          open it. It isn't on every profile yet. You know what's true about your business;
          the check tells you what the listing is saying about it.
        </p>
        <h2 class="h2">What You Get Back</h2>
        <p class="body">
          A short note by email or text, whichever you leave below. If everything looks
          right, the note says so. I do these myself, one at a time.
        </p>
      </div>
    </section>

    <section class="section" id="check">
      <div class="section__container">
        <h2 class="h2">Send Me Your Business</h2>
        <ListingCheckForm />
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .page { background-color: var(--white); }
  .intro { background: linear-gradient(135deg, var(--navy) 0%, #1a1a2e 100%); padding: 72px 24px 64px; }
  .intro__container { max-width: 820px; margin: 0 auto; }
  .crumbs { font-family: 'IBM Plex Mono', monospace; font-size: 0.75rem; color: var(--tan); margin-bottom: 24px; }
  .crumbs a { color: var(--copper-light); }
  .crumbs a:hover { color: var(--copper); }
  .overline { display: block; font-family: 'IBM Plex Mono', monospace; color: var(--copper-light); text-transform: uppercase; letter-spacing: 0.12em; font-size: 0.75rem; margin-bottom: 16px; }
  .h1 { font-family: 'Bebas Neue', sans-serif; color: var(--white); font-size: clamp(2.2rem, 6vw, 3.6rem); line-height: 1.05; margin-bottom: 24px; }
  .lede { font-family: 'Inter', sans-serif; color: var(--white); font-size: 1.15rem; line-height: 1.7; margin-bottom: 16px; }
  .lede--gold { color: var(--gold); font-weight: 600; }
  .section { padding: 64px 24px; }
  .section--tint { background-color: var(--cream); }
  .section__container { max-width: 760px; margin: 0 auto; }
  .h2 { font-family: 'Bebas Neue', sans-serif; color: var(--navy); font-size: clamp(1.8rem, 4.5vw, 2.6rem); line-height: 1.1; margin-bottom: 20px; }
  .body { font-family: 'Inter', sans-serif; color: var(--dark); font-size: 1.05rem; line-height: 1.75; margin-bottom: 32px; }
  .checks { list-style: none; }
  .checks li { font-family: 'Inter', sans-serif; color: var(--dark); font-size: 1.02rem; line-height: 1.65; padding: 12px 0 12px 28px; position: relative; border-bottom: 1px solid var(--cream); }
  .checks li::before { content: '→'; position: absolute; left: 0; color: var(--copper-dark); font-weight: 700; }
  .checks strong { color: var(--navy); }
</style>
